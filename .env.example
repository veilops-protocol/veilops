# VEILOPS environment variables. Copy to `.env.local` (website) or `.env` and adjust.
# Never commit real values. `.env*` files other than this example are git-ignored.

# --- apps/website (public, inlined into the client bundle at build time) ---
# Canonical site URL, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=https://veilops.online
# GitHub organization the site links to. The org does not exist yet.
NEXT_PUBLIC_GITHUB_ORG=veilops-protocol
# "false" hides GitHub links (for forks whose repositories do not exist).
NEXT_PUBLIC_GITHUB_PUBLISHED=true

# --- scripts/generate-samples.ts (local development only) ---
# Optional 32-byte Ed25519 seed (64 hex chars) for signing SAMPLE explorer records with a stable key.
# Only for the sample generator. It must never be committed, never be a key that signs real records,
# and never be exposed to the website (do not prefix it with NEXT_PUBLIC_).
# Leave empty to use a throwaway key generated at run time.
VEILOPS_SIGNING_SEED_HEX=
