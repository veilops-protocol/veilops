{
  "name": "veilops",
  "private": true,
  "version": "0.1.1",
  "description": "Privacy infrastructure for programmable financial operations, cryptographic proofs and selective disclosure.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @veilops/website",
    "build": "npm run build -w @veilops/website",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @veilops/website",
    "lint": "eslint packages tests examples scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "samples": "tsx scripts/generate-samples.ts",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "reproduce": "bash scripts/reproduce.sh",
    "vectors": "tsx scripts/generate-test-vectors.ts",
    "verify:python": "python3 verifiers/python/veilops_verify.py test-vectors/veilops-range-v1.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@solana-program/memo": "0.16.0",
    "@solana-program/system": "0.16.0",
    "@solana/kit": "8.6.0",
    "@solana/kit-plugin-rpc": "0.23.0",
    "@solana/kit-plugin-signer": "0.23.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
